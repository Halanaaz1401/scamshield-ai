# =============================================================================
# ScamShield AI — Environment Variable Reference & Template
# =============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT REPOSITORY.
#
# FRONTEND CONFIGURATION (Client-Side)
# -----------------------------------------------------------------------------
# Production API Gateway endpoint or local backend URL:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# BACKEND CONFIGURATION (Server-Side Lambda / Local Server)
# -----------------------------------------------------------------------------
# Optional Google Gemini API key for AI Intent Reasoning Layer:
# (Keep strictly on backend/Lambda; NEVER expose to NEXT_PUBLIC_* variables)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_ID=gemini-2.5-flash

# Optional Google Web Risk API Key for Live Threat Intelligence:
GOOGLE_WEB_RISK_API_KEY=YOUR_GOOGLE_WEB_RISK_API_KEY

# AWS Deployment Parameters (AWS SAM / CloudFormation):
AWS_REGION=us-east-1
ALLOWED_ORIGINS=*
DYNAMODB_TABLE_NAME=scamshield-ai-reports
LOG_LEVEL=INFO
